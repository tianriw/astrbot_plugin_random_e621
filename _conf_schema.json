        "default": "~rating:safe ~rating:questionable -female -tan_body -tan_fur -belly -huge_belly -penis -huge_checks -big_checks -fat_face -3_toes -big_butt -butt -the_amazing_digital_circus -hollow_knight_(franchise) -sex -sex_toy_in_ass -painting_(artwork) -pokemon_(species) -hug -ball_fondling -balls -king_candy -kissing -ambiguous_gender -cum -humanoid -overweight -oliver_(cloudy_hyena) -bondage -breast_growth -areola -gynomorph -sonic_the_hedgehog_(series) -bulge -hazbin_hotel -nude -erection"
